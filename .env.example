# Credenciales del número de PRUEBA de Meta
WHATSAPP_PHONE_NUMBER_ID=PEGA_AQUI_TU_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=PEGA_AQUI_TU_WABA_ID
WHATSAPP_ACCESS_TOKEN=PEGA_AQUI_TU_TOKEN_TEMPORAL

# Inventa una cadena larga y privada; Meta la usará al verificar el webhook
WHATSAPP_VERIFY_TOKEN=inventa_una_clave_larga_para_verificar_el_webhook

# Opcional para validar la firma de los webhooks. Copiar desde la configuración
# básica de la app de Meta. Si se deja vacío, la validación de firma se omite.
META_APP_SECRET=

# Debe ser una versión Graph API vigente y habilitada para tu app.
META_GRAPH_API_VERSION=v23.0

PORT=8000
